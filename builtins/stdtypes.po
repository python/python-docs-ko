#: ../../builtins/stdtypes.rst:6357
msgid "Special Attributes of ``GenericAlias`` objects"
msgstr ""

#: ../../builtins/stdtypes.rst:6359
msgid "All parameterized generics implement special read-only attributes."
msgstr ""

#: ../../builtins/stdtypes.rst:6363
msgid "This attribute points at the non-parameterized generic class::"
msgstr ""

#: ../../builtins/stdtypes.rst:6365
msgid ""
">>> list[int].__origin__\n"
"<class 'list'>"
msgstr ""

#: ../../builtins/stdtypes.rst:6371
msgid ""
"This attribute is a :class:`tuple` (possibly of length 1) of generic "
"types passed to the original :meth:`~object.__class_getitem__` of the "
"generic class::"
msgstr ""

#: ../../builtins/stdtypes.rst:6375
msgid ""
">>> dict[str, list[int]].__args__\n"
"(<class 'str'>, list[int])"
msgstr ""

#: ../../builtins/stdtypes.rst:6381
msgid ""
"This attribute is a lazily computed tuple (possibly empty) of unique type"
" variables found in ``__args__``::"
msgstr ""

#: ../../builtins/stdtypes.rst:6384
msgid ""
">>> from typing import TypeVar\n"
"\n"
">>> T = TypeVar('T')\n"
">>> list[T].__parameters__\n"
"(~T,)"
msgstr ""

#: ../../builtins/stdtypes.rst:6392
msgid ""
"A ``GenericAlias`` object with :class:`typing.ParamSpec` parameters may "
"not have correct ``__parameters__`` after substitution because "
":class:`typing.ParamSpec` is intended primarily for static type checking."
msgstr ""

#: ../../builtins/stdtypes.rst:6399
msgid ""
"A boolean that is true if the alias has been unpacked using the ``*`` "
"operator (see :data:`~typing.TypeVarTuple`)."
msgstr ""

#: ../../builtins/stdtypes.rst:6407
