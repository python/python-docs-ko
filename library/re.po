">>> displaymatch(pair_re.prefixmatch(\"718ak\"))     # No pairs.\n"
">>> displaymatch(pair_re.prefixmatch(\"354aa\"))     # Pair of aces.\n"
"\"<Match: '354aa', groups=('a',)>\""
