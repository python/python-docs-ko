#, python-brace-format
msgid ""
">>> valid_hand_re = re.compile(r\"^[a2-9tjqk]{5}$\")\n"
">>> displaymatch(valid_hand_re.search(\"akt5q\"))  # Valid.\n"
"\"<Match: 'akt5q', groups=()>\"\n"
">>> displaymatch(valid_hand_re.search(\"akt5e\"))  # Invalid.\n"
">>> displaymatch(valid_hand_re.search(\"akt\"))    # Invalid.\n"
">>> displaymatch(valid_hand_re.search(\"727ak\"))  # Valid.\n"
"\"<Match: '727ak', groups=()>\""
msgstr ""

#: ../../library/re.rst:1831
msgid ""
"That last hand, ``\"727ak\"``, contained a pair, or two of the same "
"valued cards. To match this with a regular expression, one could use "
"backreferences as such::"
msgstr ""
"마지막 패 ``\"727ak\"``\\는 페어, 즉 같은 값의 카드 두 장을 포함합니다. 이것을 정규식과 일치시키려면, 역참조를 "
"다음과 같이 사용할 수 있습니다::"

#: ../../library/re.rst:1834
msgid ""
">>> pair_re = re.compile(r\".*(.).*\\1\")\n"
">>> displaymatch(pair_re.prefixmatch(\"717ak\"))     # Pair of 7s.\n"
