msgstr "인자:"

#: ../../library/tkinter.font.rst
msgid "*font* - font specifier tuple (family, size, options)"
msgstr "*font* - 글꼴 지정자 튜플 (패밀리, 크기, 옵션)"

#: ../../library/tkinter.font.rst
msgid "*name* - unique font name"
msgstr "*name* - 고유한 글꼴 이름"

#: ../../library/tkinter.font.rst
