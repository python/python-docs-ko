"begin_fill()\n"
"for i in range(4):\n"
"    forward(100)\n"
"    right(90)\n"
"end_fill()\n"
"\n"
"forward(200)"
msgstr ""
"begin_fill()\n"
"for i in range(4):\n"
"    forward(100)\n"
"    right(90)\n"
"end_fill()\n"
"\n"
"forward(200)"

